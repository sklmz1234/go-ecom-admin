{
  "uid": "go-ecom-admin-overview",
  "title": "go-ecom-admin 总览（阶段 2D）",
  "description": "四张图起步：QPS / P99-P50 延迟 / gRPC 错误率 / Go runtime。事故重演验收：停掉 MySQL 后第三张图应立即飙升，恢复后回落。",
  "tags": ["go-ecom-admin", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "QPS 按路由（网关）",
      "description": "rate(请求计数)。标签是路由模式而非实际路径——防基数爆炸的成果在这里可见：/products/42 和 /products/7 归并成同一条曲线。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (http_request_method, http_route) (rate(http_server_request_duration_seconds_count{job=\"gateway\"}[$__rate_interval]))",
          "legendFormat": "{{http_request_method}} {{http_route}}",
          "exemplar": true,
          "range": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "延迟 P99 / P50 按路由（网关）",
      "description": "histogram_quantile 从直方图桶估算分位数。注意它是区间窗口内的估算值，不是精确值——桶边界设计影响精度。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"gateway\"}[$__rate_interval])))",
          "legendFormat": "P99 {{http_route}}",
          "exemplar": true,
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket{job=\"gateway\"}[$__rate_interval])))",
          "legendFormat": "P50 {{http_route}}",
          "exemplar": true,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "gRPC 错误率按方法（事故重演主视图）",
      "description": "非 OK 状态码的 RPC 速率。验收场景：docker stop mysql 后这里立即飙升，恢复后回落。rpc_response_status_code=OK 之外的取值（NotFound/Internal/Unavailable 等）均为错误。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "alert": {},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job, rpc_method) (rate(rpc_server_call_duration_seconds_count{rpc_response_status_code!=\"OK\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{rpc_method}}",
          "exemplar": true,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Go runtime：goroutines 与堆内存",
      "description": "goroutine 数缓慢爬升不回落 ≈ goroutine 泄漏的经典信号；堆内存阶梯上行后被 GC 打回是健康形态。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "heap.*" },
            "properties": [
              { "id": "unit", "value": "bytes" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "go_goroutines",
          "legendFormat": "goroutines {{job}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "go_memstats_heap_alloc_bytes",
          "legendFormat": "heap {{job}}",
          "range": true
        }
      ]
    }
  ]
}
